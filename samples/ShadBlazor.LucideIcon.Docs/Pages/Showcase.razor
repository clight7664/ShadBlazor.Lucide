@page "/showcase"
@using ShadBlazor.LucideIcon

<PageTitle>Showcase - ShadBlazor.LucideIcon</PageTitle>

<div class="showcase-container">
    <div class="hero-section" style="padding-top: 2rem;">
        <h1 class="hero-title">Showcase</h1>
        <p class="hero-desc">由开发者社区基于 ShadBlazor 与 Lucide Icons 构建的优秀项目</p>
    </div>

    <div class="showcase-grid">
        <div class="showcase-card">
            <div class="showcase-banner">
                <LucideSparkles Size="48" Color="#ffffff" />
            </div>
            <div class="showcase-content">
                <h3>ShadBlazor Admin Pro</h3>
                <p>基于 Tailwind CSS 与 Lucide 图标打造的企业级极简后台管理系统。</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-banner">
                <LucideShield Size="48" Color="#ffffff" />
            </div>
            <div class="showcase-content">
                <h3>Lucide Blazor Canvas</h3>
                <p>在线可交互式矢量图元编辑器与图标设计工具。</p>
            </div>
        </div>
    </div>
</div>
