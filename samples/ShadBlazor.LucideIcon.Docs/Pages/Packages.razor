@page "/packages"
@using ShadBlazor.LucideIcon
@using ShadBlazor.LucideIcon.Docs.Services
@inject I18nService I18n
@implements IDisposable

<PageTitle>@I18n.T("Packages.Title") - ShadBlazor Ecosystem</PageTitle>

<div class="packages-container">
    <div class="hero-section" style="padding-top: 2rem;">
        <h1 class="hero-title">@I18n.T("Packages.Title")</h1>
        <p class="hero-desc">@I18n.T("Packages.Desc")</p>
    </div>

    <div class="packages-grid">
        <div class="pkg-card">
            <div class="pkg-header">
                <LucideSparkles Size="28" Color="var(--accent-color)" />
                <h3>ShadBlazor.LucideIcon</h3>
            </div>
            <p>@I18n.T("Packages.Core.Desc")</p>
            <div class="pkg-install"><code>dotnet add package ShadBlazor.LucideIcon</code></div>
        </div>

        <div class="pkg-card">
            <div class="pkg-header">
                <LucideCpu Size="28" Color="var(--accent-color)" />
                <h3>ShadBlazor.LucideIcon.Generator</h3>
            </div>
            <p>@I18n.T("Packages.Gen.Desc")</p>
            <div class="pkg-install"><code>dotnet run --project src/ShadBlazor.LucideIcon.Generator</code></div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
