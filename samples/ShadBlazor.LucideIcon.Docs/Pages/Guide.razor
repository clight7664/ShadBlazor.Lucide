@page "/guide"
@using ShadBlazor.LucideIcon
@using ShadBlazor.LucideIcon.Docs.Services
@inject I18nService I18n
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@I18n.T("Guide.Title") - ShadBlazor.LucideIcon</PageTitle>

<div class="guide-container">
    <aside class="guide-sidebar">
        <div class="guide-nav-section">
            <h4>@I18n.T("Guide.Nav.Intro")</h4>
            <button type="button" class="guide-nav-link @(ActiveSection == "what-is-lucide" ? "active" : "")" @onclick='() => ScrollToSection("what-is-lucide")'>
                @I18n.T("Guide.Nav.WhatIs")
            </button>
            <button type="button" class="guide-nav-link @(ActiveSection == "installation" ? "active" : "")" @onclick='() => ScrollToSection("installation")'>
                @I18n.T("Guide.Nav.Installation")
            </button>
        </div>

        <div class="guide-nav-section">
            <h4>@I18n.T("Guide.Nav.Basics")</h4>
            <button type="button" class="guide-nav-link @(ActiveSection == "basics" ? "active" : "")" @onclick='() => ScrollToSection("basics")'>
                @I18n.T("Guide.Nav.StrongTyped")
            </button>
            <button type="button" class="guide-nav-link @(ActiveSection == "dynamic" ? "active" : "")" @onclick='() => ScrollToSection("dynamic")'>
                @I18n.T("Guide.Nav.Dynamic")
            </button>
        </div>

        <div class="guide-nav-section">
            <h4>@I18n.T("Guide.Nav.Advanced")</h4>
            <button type="button" class="guide-nav-link @(ActiveSection == "tailwind" ? "active" : "")" @onclick='() => ScrollToSection("tailwind")'>
                @I18n.T("Guide.Nav.Tailwind")
            </button>
            <button type="button" class="guide-nav-link @(ActiveSection == "nuget-publish" ? "active" : "")" @onclick='() => ScrollToSection("nuget-publish")'>
                @I18n.T("Guide.Nav.NugetPublish")
            </button>
        </div>
    </aside>

    <article class="guide-article">
        <h1 id="what-is-lucide">@I18n.T("Guide.Nav.WhatIs")</h1>
        <p class="lead">
            @I18n.T("Guide.Lead")
        </p>

        <h2 id="installation">@I18n.T("Guide.Install.Title")</h2>
        <p>@I18n.T("Guide.Install.Desc")</p>
        <pre class="code-block"><code>dotnet add package ShadBlazor.LucideIcon</code></pre>

        <p>@I18n.T("Guide.Install.ImportsDesc")</p>
        <pre class="code-block"><code>@@using ShadBlazor.LucideIcon
@@using ShadBlazor.LucideIcon.Base</code></pre>

        <h2 id="basics">@I18n.T("Guide.Basics.Title")</h2>
        <h3>@I18n.T("Guide.Basics.StrongTitle")</h3>
        <pre class="code-block"><code>&lt;LucideCamera Size="24" Color="currentColor" StrokeWidth="2" /&gt;
&lt;LucideCheck Size="20" Color="#10b981" /&gt;
&lt;LucideSparkles Size="24" Class="text-rose-500 animate-spin" /&gt;</code></pre>

        <h3 id="dynamic">@I18n.T("Guide.Basics.DynamicTitle")</h3>
        <pre class="code-block"><code>&lt;LucideIcon Name="camera" Size="24" /&gt;
&lt;LucideIcon Icon="LucideIconName.Settings" Size="20" /&gt;</code></pre>

        <h2 id="tailwind">@I18n.T("Guide.Tailwind.Title")</h2>
        <p>@I18n.T("Guide.Tailwind.Desc")</p>
        <pre class="code-block"><code>&lt;LucideSearch Class="w-4 h-4 text-muted-foreground mr-2" /&gt;</code></pre>

        <h2 id="nuget-publish">@I18n.T("Guide.Nuget.Title")</h2>
        
        <h3>@I18n.T("Guide.Nuget.Step1")</h3>
        <p>@I18n.T("Guide.Nuget.Step1Desc")</p>
        <pre class="code-block"><code>&lt;PropertyGroup&gt;
  &lt;Version&gt;1.33.0&lt;/Version&gt;
  &lt;Authors&gt;ShadBlazor Team&lt;/Authors&gt;
  &lt;RepositoryUrl&gt;https://github.com/clight7664/ShadBlazor.Lucide&lt;/RepositoryUrl&gt;
&lt;/PropertyGroup&gt;</code></pre>

        <h3>@I18n.T("Guide.Nuget.Step2")</h3>
        <p>@I18n.T("Guide.Nuget.Step2Desc")</p>
        <pre class="code-block"><code>dotnet build -c Release
dotnet test tests/ShadBlazor.LucideIcon.Tests/ShadBlazor.LucideIcon.Tests.csproj -c Release</code></pre>

        <h3>@I18n.T("Guide.Nuget.Step3")</h3>
        <p>@I18n.T("Guide.Nuget.Step3Desc")</p>
        <pre class="code-block"><code>dotnet pack src/ShadBlazor.LucideIcon/ShadBlazor.LucideIcon.csproj -c Release -o ./artifacts</code></pre>

        <h3>@I18n.T("Guide.Nuget.Step4")</h3>
        <p>@I18n.T("Guide.Nuget.Step4Desc")</p>
        <pre class="code-block"><code>dotnet nuget push ./artifacts/ShadBlazor.LucideIcon.*.nupkg --api-key &lt;YOUR_API_KEY&gt; --source https://api.nuget.org/v3/index.json --skip-duplicate</code></pre>

        <h3>@I18n.T("Guide.Nuget.Step5")</h3>
        <p>@I18n.T("Guide.Nuget.Step5Desc")</p>
        <pre class="code-block"><code># PowerShell 脚本一键发布
./scripts/publish-nuget.ps1 -ApiKey "oy2..."

# 仅打包测试（不推送到源）
./scripts/publish-nuget.ps1 -SkipPush</code></pre>
    </article>
</div>

@code {
    private string ActiveSection = "what-is-lucide";

    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ScrollToSection(string elementId)
    {
        ActiveSection = elementId;
        await JS.InvokeVoidAsync("eval", $"document.getElementById('{elementId}')?.scrollIntoView({{ behavior: 'smooth', block: 'start' }})");
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
