@page "/showcase"
@using ShadBlazor.LucideIcon
@using ShadBlazor.LucideIcon.Docs.Services
@inject I18nService I18n
@implements IDisposable

<PageTitle>@I18n.T("Showcase.Title") - ShadBlazor.LucideIcon</PageTitle>

<div class="showcase-container">
    <div class="hero-section" style="padding-top: 2rem;">
        <h1 class="hero-title">@I18n.T("Showcase.Title")</h1>
        <p class="hero-desc">@I18n.T("Showcase.Desc")</p>
    </div>

    <div class="showcase-grid">
        <div class="showcase-card">
            <div class="showcase-banner">
                <LucideSparkles Size="48" Color="#ffffff" />
            </div>
            <div class="showcase-content">
                <h3>@I18n.T("Showcase.Admin.Title")</h3>
                <p>@I18n.T("Showcase.Admin.Desc")</p>
            </div>
        </div>

        <div class="showcase-card">
            <div class="showcase-banner">
                <LucideShield Size="48" Color="#ffffff" />
            </div>
            <div class="showcase-content">
                <h3>@I18n.T("Showcase.Canvas.Title")</h3>
                <p>@I18n.T("Showcase.Canvas.Desc")</p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
